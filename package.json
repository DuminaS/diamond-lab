{
  "name": "gridiron-lab",
  "version": "1.0.0",
  "description": "Gridiron Lab - QB career simulator",
  "scripts": {
    "test": "npm run test:balance && npm run build && playwright test",
    "test:balance": "node --test tests/balance/*.node.mjs",
    "balance:audit": "node scripts/balance-audit.mjs",
    "test:smoke": "npm run build && playwright test tests/smoke",
    "test:regression": "npm run build && playwright test tests/regression",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
